extends ../layout

block content
  main.produtos-page
    header.page-header
      h1.title Lista de Produtos
      p.lead Confira preços e escolha sua unha favorita!
    section.produtos-grid
      each item in produtos
        article.card
          header.card-header
            h2.card-title #{item.nome}
          .card-body
            p.card-price Preço: R$ #{item.preco.toFixed(2)}
          footer.card-footer
            button.btn-comprar(type="button") Comprar
